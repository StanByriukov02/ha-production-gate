<?xml version="1.0"?>
<robot name="head_neck_pan_tilt_v1">
  <link name="neck_base_link">
    <visual><geometry><cylinder radius="0.03" length="0.04"/></geometry></visual>
  </link>
  <link name="pan_link">
    <visual><origin xyz="0 0 0.03" rpy="0 0 0"/><geometry><box size="0.05 0.05 0.06"/></geometry></visual>
  </link>
  <joint name="neck_pan_joint" type="revolute">
    <parent link="neck_base_link"/><child link="pan_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.2" upper="1.2" effort="2" velocity="2"/>
  </joint>
  <link name="sensor_mount_link">
    <visual><origin xyz="0.04 0 0" rpy="0 0 0"/><geometry><box size="0.06 0.04 0.04"/></geometry></visual>
  </link>
  <joint name="neck_tilt_joint" type="revolute">
    <parent link="pan_link"/><child link="sensor_mount_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="0.8" effort="2" velocity="2"/>
  </joint>
</robot>
