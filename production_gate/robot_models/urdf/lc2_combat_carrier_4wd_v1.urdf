<?xml version="1.0"?>
<robot name="lc2_combat_carrier_4wd_v1">
  <!-- M-combat-earth · 500 m cave · chip VI-2 + LC-2 tier-J ×4 -->
  <link name="base_link">
    <visual>
      <geometry><mesh filename="robot_combat_carrier_body_v1.stl" scale="0.001 0.001 0.001"/></geometry>
    </visual>
    <collision>
      <geometry><box size="0.572 0.384 0.212"/></geometry>
    </collision>
  </link>

  <link name="compute_vault_link">
    <visual>
      <origin xyz="0 0.02 0.15" rpy="0 0 0"/>
      <geometry><box size="0.148 0.108 0.028"/></geometry>
      <material name="al_bare"><color rgba="0.72 0.75 0.78 1"/></material>
    </visual>
  </link>
  <joint name="compute_vault_fixed" type="fixed">
    <parent link="base_link"/><child link="compute_vault_link"/>
    <origin xyz="0 0.02 0.12" rpy="0 0 0"/>
  </joint>

  <link name="chip_package_link">
    <visual>
      <geometry><box size="0.042 0.042 0.004"/></geometry>
      <material name="package"><color rgba="0.78 0.65 0.45 1"/></material>
    </visual>
  </link>
  <joint name="chip_fixed" type="fixed">
    <parent link="compute_vault_link"/><child link="chip_package_link"/>
    <origin xyz="0 0 0.018" rpy="0 0 0"/>
  </joint>

  <!-- wheels: continuous joints · LC-2 FOC drive -->
  <link name="wheel_fl_link"><visual><geometry><cylinder radius="0.10" length="0.08"/></geometry></visual></link>
  <joint name="wheel_fl_joint" type="continuous">
    <parent link="base_link"/><child link="wheel_fl_link"/>
    <origin xyz="-0.25 -0.165 0.10" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_fr_link"><visual><geometry><cylinder radius="0.10" length="0.08"/></geometry></visual></link>
  <joint name="wheel_fr_joint" type="continuous">
    <parent link="base_link"/><child link="wheel_fr_link"/>
    <origin xyz="0.25 -0.165 0.10" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_rl_link"><visual><geometry><cylinder radius="0.10" length="0.08"/></geometry></visual></link>
  <joint name="wheel_rl_joint" type="continuous">
    <parent link="base_link"/><child link="wheel_rl_link"/>
    <origin xyz="-0.25 0.165 0.10" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_rr_link"><visual><geometry><cylinder radius="0.10" length="0.08"/></geometry></visual></link>
  <joint name="wheel_rr_joint" type="continuous">
    <parent link="base_link"/><child link="wheel_rr_link"/>
    <origin xyz="0.25 0.165 0.10" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
</robot>
