    {
      "id": "newton_ballistic",
      "cite": "Newtonian ballistic hop under constant g (teaching)",
      "used": [
        "apex",
        "tof",
        "range"
      ]
    },
    {
      "id": "lunar_g",
      "cite": "g_moon≈1.62 m/s^2 · Dual vs Earth 9.81",
      "used": [
        "g_moon",
        "g_earth"
      ]
    }
  ],
  "rust_oracle": {
    "crate": "ha_physics_gate",
    "cmd": "ha-physics-gate rigid-hop --catalog <path> --v-up <u> --v-h <h> [--body moon|earth]"
  },
  "honesty": [
    "teaching ballistic / Euler free-body — not full constrained 6DOF multibody",
