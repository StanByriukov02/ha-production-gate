  "gates": {
    "v_up_min": 0.0,
    "v_up_max": 100.0,
    "v_h_min": 0.0,
    "v_h_max": 100.0
  },
  "dual_anchors": {
    "safe_v_mult": 1.0,
    "hostile_v_mult": 2.0,
    "body": "moon",
    "cite": "Dual: catalog defaults vs 2x Hostile recover hop (ballistics G4)"
  }
}
