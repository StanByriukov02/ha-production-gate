      "cite": "Matthia & Berger 2024 Space Weather — neutron buildup peak ~90 g/cm2",
      "used": ["peak_areal", "fraction_multiplier", "total_dose_multiplier", "sigma"]
    }
  ],
  "rust_oracle": {
    "crate": "ha_physics_gate",
    "cmd": "ha-physics-gate albedo-dose --catalog <path> --site-class <id> --shield-g-cm2 <g> --anchor-gy <D> [--see-base <s>]"
  },
