<?xml version="1.0"?>
<!-- ROS tutorial-class skid-steer cart · open teaching body · not OEM
     inertial + collision primitives enable Dual contact.source=urdf_extract -->
<robot name="ros_skidsteer_v1">
  <link name="base_link">
    <inertial>
      <mass value="50.0"/>
      <inertia ixx="0.4" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry><box size="0.4 0.28 0.12"/></geometry>
      <material name="base"><color rgba="0.2 0.45 0.35 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry><box size="0.4 0.28 0.12"/></geometry>
    </collision>
  </link>

  <link name="track_left_link">
    <inertial>
      <mass value="6.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.03"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.06" length="0.28"/></geometry>
      <material name="track"><color rgba="0.12 0.12 0.14 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.06" length="0.28"/></geometry>
    </collision>
  </link>
  <joint name="track_left_joint" type="continuous">
    <parent link="base_link"/><child link="track_left_link"/>
    <origin xyz="0 0.16 0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="track_right_link">
    <inertial>
      <mass value="6.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.03"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.06" length="0.28"/></geometry>
      <material name="track2"><color rgba="0.12 0.12 0.14 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.06" length="0.28"/></geometry>
    </collision>
  </link>
  <joint name="track_right_joint" type="continuous">
    <parent link="base_link"/><child link="track_right_link"/>
    <origin xyz="0 -0.16 0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="payload_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.15 0.15 0.08"/></geometry>
      <material name="payload"><color rgba="0.75 0.55 0.2 1"/></material>
    </visual>
  </link>
  <joint name="payload_joint" type="fixed">
    <parent link="base_link"/><child link="payload_link"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
  </joint>
</robot>
