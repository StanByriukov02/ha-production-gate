{
  "schema_id": "governance_action_receipt_schema_v1",
  "version": 1,
  "proof_tier": "GOVERNANCE_SLICE",
  "objects": {
    "PolicyProposal": {
      "required": ["action_id", "command", "confidence", "source"],
      "properties": {
        "action_id": { "type": "integer", "minimum": 0 },
        "command": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source": { "type": "string" }
      }
    },
    "GovernanceVerdict": {
      "required": ["allowed", "gate_thresholds", "proof_tier"],
      "properties": {
        "allowed": { "type": "boolean" },
        "veto_reason": { "type": ["string", "null"] },
        "rule_id": { "type": ["string", "null"] },
        "gate_thresholds": { "type": "object" },
        "proof_tier": { "type": "string" }
      }
    },
    "ActionReceipt": {
      "required": ["action_id", "carrier_id", "proposal", "verdict"],
      "properties": {
        "action_id": { "type": "integer" },
        "carrier_id": { "type": "string" },
        "proposal": { "$ref": "#/objects/PolicyProposal" },
        "verdict": { "$ref": "#/objects/GovernanceVerdict" },
        "cursor_m": { "type": "number" }
      }
    }
  },
  "tabu": "claim MEASURED governance · claim VLA wired"
}
