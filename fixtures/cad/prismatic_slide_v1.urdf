<?xml version="1.0"?>
<robot name="prismatic_slide_v1">
  <link name="base_link">
    <visual>
      <geometry><box size="0.2 0.2 0.02"/></geometry>
    </visual>
  </link>
  <link name="slide_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.1"/></geometry>
    </visual>
  </link>
  <joint name="slide_joint" type="prismatic">
    <parent link="base_link"/><child link="slide_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.2" effort="50" velocity="0.5"/>
  </joint>
</robot>
