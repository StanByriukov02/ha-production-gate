<?xml version="1.0"?>
<robot name="hexapod_leg_3dof_v1">
  <!-- 3-DOF planar-degenerate leg · coxa/femur/tibia · Z revolute chain -->
  <link name="body_mount">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.02"/></geometry>
      <material name="mount"><color rgba="0.4 0.4 0.45 1"/></material>
    </visual>
  </link>

  <link name="coxa_link">
    <visual>
      <origin xyz="0.0275 0 0" rpy="0 0 0"/>
      <geometry><box size="0.055 0.02 0.02"/></geometry>
      <material name="coxa"><color rgba="0.55 0.35 0.2 1"/></material>
    </visual>
  </link>
  <joint name="coxa_joint" type="revolute">
    <parent link="body_mount"/><child link="coxa_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.9" upper="0.9" effort="3" velocity="2"/>
  </joint>

  <link name="femur_link">
    <visual>
      <origin xyz="0.06 0 0" rpy="0 0 0"/>
      <geometry><box size="0.12 0.018 0.018"/></geometry>
      <material name="femur"><color rgba="0.3 0.5 0.35 1"/></material>
    </visual>
  </link>
  <joint name="femur_joint" type="revolute">
    <parent link="coxa_link"/><child link="femur_link"/>
    <origin xyz="0.055 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.4" upper="1.4" effort="4" velocity="2"/>
  </joint>

  <link name="foot_link">
    <visual>
      <origin xyz="0.0475 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.012"/></geometry>
      <material name="foot"><color rgba="0.2 0.2 0.25 1"/></material>
    </visual>
  </link>
  <joint name="tibia_joint" type="revolute">
    <parent link="femur_link"/><child link="foot_link"/>
    <origin xyz="0.12 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.6" upper="1.6" effort="3" velocity="2"/>
  </joint>
</robot>
