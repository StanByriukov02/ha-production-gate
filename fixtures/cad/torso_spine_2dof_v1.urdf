<?xml version="1.0"?>
<robot name="torso_spine_2dof_v1">
  <link name="pelvis_link">
    <visual><geometry><box size="0.20 0.14 0.06"/></geometry></visual>
  </link>
  <link name="spine_yaw_link">
    <visual><origin xyz="0 0 0.08" rpy="0 0 0"/><geometry><box size="0.12 0.10 0.16"/></geometry></visual>
  </link>
  <joint name="spine_yaw_joint" type="revolute">
    <parent link="pelvis_link"/><child link="spine_yaw_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="8" velocity="1.5"/>
  </joint>
  <link name="chest_mount_link">
    <visual><origin xyz="0 0 0.10" rpy="0 0 0"/><geometry><box size="0.14 0.12 0.08"/></geometry></visual>
  </link>
  <joint name="spine_pitch_joint" type="revolute">
    <parent link="spine_yaw_link"/><child link="chest_mount_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.4" upper="0.5" effort="8" velocity="1.5"/>
  </joint>
</robot>
