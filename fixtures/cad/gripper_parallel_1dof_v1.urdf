<?xml version="1.0"?>
<robot name="gripper_parallel_1dof_v1">
  <link name="gripper_base_link">
    <visual><geometry><box size="0.04 0.06 0.02"/></geometry></visual>
  </link>
  <link name="finger_link">
    <visual><origin xyz="0.025 0 0" rpy="0 0 0"/><geometry><box size="0.05 0.01 0.03"/></geometry></visual>
  </link>
  <joint name="gripper_joint" type="revolute">
    <parent link="gripper_base_link"/><child link="finger_link"/>
    <origin xyz="0.02 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.6" effort="1.5" velocity="2"/>
  </joint>
</robot>
